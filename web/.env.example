# Copy to web/.env.local for local development (gitignored).
# Use the DEV Supabase project locally and for Vercel Preview.
# Use the PROD Supabase project for Vercel Production only.
# See docs/ENVIRONMENTS.md.

# Public (safe for the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose via NEXT_PUBLIC_*)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
