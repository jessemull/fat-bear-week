{
  "name": "fat-bear-week-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "security": "npm audit --omit=dev",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "env -u ELECTRON_RUN_AS_NODE start-server-and-test \"npm run dev\" http://localhost:3000 \"cypress run\"",
    "cypress:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved",
    "lighthouse": "env -u ELECTRON_RUN_AS_NODE lhci autorun"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cypress": "^15.20.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.3.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
